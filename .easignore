# VCS
.git/
.github/
.gitlab/

# IDE/OS
.idea/
.vscode/
.DS_Store
**/.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node modules (workspace and subpackages)
node_modules/
**/node_modules/

# Package manager stores/caches
.pnpm-store/
**/.pnpm-store/
.yarn/
.cache/
pnpm-lock.yaml

# Build outputs and caches
**/dist/
**/build/
**/.turbo/
**/.expo/
**/coverage/
**/web-build/

# Android
**/android/build/
**/android/.gradle/
**/android/local.properties
**/*.keystore
**/*.jks
**/*.aab
**/*.apk

# iOS
**/ios/build/
**/ios/Pods/
**/ios/.bundle/
**/*.ipa
**/*.dSYM.zip
**/*.dSYM

# Documentation (not needed for builds)
*.md
!README.md
docs/
**/docs/

# Test files
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/test/
**/tests/

# Environment files (use EAS secrets instead)
.env
.env.local
.env.*.local
**/.env

# Misc archives
**/*.tgz
**/*.zip

# ECI PDFs (if not needed for builds)
eci_pdfs/

# Database
DB_store/
**/DB_store/


