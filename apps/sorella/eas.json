{
  "cli": {
    "version": ">= 16.27.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "env": { "EXPO_USE_METRO_WORKSPACE_ROOT": "1" },
      "distribution": "internal",
      "credentialsSource": "remote",
      "android": { "buildType": "apk" }
    },
    "production": {
      "env": { "EXPO_USE_METRO_WORKSPACE_ROOT": "1" },
      "credentialsSource": "remote",
      "android": { "buildType": "app-bundle" },
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
